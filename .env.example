# Development Environment
# Sao chép file này thành .env rồi điền giá trị thật
# cp .env.example .env

NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/timemanagement
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<password>
POSTGRES_DB=timemanagement

# JWT & Session
JWT_SECRET=your-super-secret-jwt-key-min-16-chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=your-session-secret-change-in-production

# URLs
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email Configuration (Gmail SMTP)
# Get App Password at: https://myaccount.google.com/apppasswords
# App Password is 16 characters WITHOUT spaces (e.g., jhbaeqrdnxbluizs)
EMAIL_USER=your@gmail.com
EMAIL_PASS=your16characterapppassword
